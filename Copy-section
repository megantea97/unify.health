<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Unify.Health Band Section</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- Stand-in for Urbane. Swap the font-family below when the brand font is licensed for web. -->
<link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --blue:#024CEB;
    --navy:#050924;
    --white:#FFFFFF;
    --f-display:"Urbane","Urbanist",system-ui,Arial,sans-serif;
    --gutter:clamp(16px,3.2vw,48px);
    --line:rgba(5,9,36,.08);
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--white);color:var(--navy);-webkit-font-smoothing:antialiased}

  /* Section */
  .band{
    position:relative;
    min-height:100vh;
    display:flex;
    align-items:center;
    padding:0 var(--gutter);
    background:var(--white);
    overflow:clip;
  }

  /* Hairline grid: 4 columns plus horizontals at 17% and 83% */
  .band::before{
    content:"";
    position:absolute;
    inset:0;
    pointer-events:none;
    background:
      linear-gradient(to right,var(--line) 1px,transparent 1px) 0 0/25% 100%,
      linear-gradient(var(--line),var(--line)) 0 17%/100% 1px no-repeat,
      linear-gradient(var(--line),var(--line)) 0 83%/100% 1px no-repeat;
  }

  .scatter{
    position:relative;
    margin:0;
    max-width:12.5em;
    font:500 clamp(38px,7.4vw,124px)/1.02 var(--f-display);
    letter-spacing:-.03em;
    color:var(--navy);
  }
  .scatter .w{display:inline-block;white-space:nowrap}
  .scatter .b{color:var(--blue)}
  .scatter .ch{
    display:inline-block;
    transition:transform 1.1s cubic-bezier(.16,1,.3,1),opacity .9s ease;
